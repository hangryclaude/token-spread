{
  "name": "token-spread",
  "version": "0.1.0",
  "description": "A read-only audit of what your LLM usage costs, and a register of 187 cost techniques adjudicated against one question: does the model read the same bytes?",
  "type": "module",
  "bin": {
    "token-spread": "./src/cli.ts"
  },
  "license": "MIT AND CC-BY-4.0",
  "private": true,
  "scripts": {
    "audit": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "register": "bun run src/register/cli.ts",
    "register:stat": "bun run src/register/cli.ts stat",
    "register:stale": "bun run src/register/cli.ts stale",
    "build:fonts": "bun run ./bench/build-fonts.ts",
    "build:figures": "bun run ./bench/margin-model.ts --write",
    "check:page": "node site/tools/page-checks.mjs",
    "check:page:self": "node site/tools/page-checks.mjs --self-test",
    "check:page:full": "node site/tools/page-checks.mjs --full",
    "shoot:audit": "node site/tools/shoot-audit.mjs",
    "shoot:audit:check": "node site/tools/shoot-audit.mjs --check",
    "sweep:pricing": "node site/tools/sweep-pricing.mjs",
    "sweep:pricing:control": "node site/tools/sweep-pricing.mjs --control",
    "render:media": "node docs/media/render.mjs",
    "render:media:check": "node docs/media/render.mjs --check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/bun": "^1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "RUNNING.md"
  ]
}
